    <repository type="git" url="git://github.com/yellowfeather/DbfDataReader" commit="e5fda7f6bbca5ebb57adaa1f9ba9f80074422440" />
    <dependencies>
      <group targetFramework="net10.0" />
      <group targetFramework=".NETStandard2.1">
